# 统一运行时产物
output/**
!output/.gitkeep
!output/logs/
!output/logs/.gitkeep
!output/backups/
!output/backups/.gitkeep

# 运行时产物
*.log
watch.pid
__pycache__/
*.pyc

# 备份
*.bak
*.bak-*

# 个人配置（绝不应入库）
config.toml
config.toml.*
cdp_port.txt
verification.json
verification.json.tmp
repair-report.json
repair.lock
*.repair-tmp
